# Copy to .env.local (gitignored) for local development and e2e.
#
# These are the DEV project's values — the Ireland project, which the e2e
# suite seeds and reseeds. Never put the production project here: .env.local
# is what `expo start` and Playwright pick up, and seeding writes fixtures.
#
# Production and preview builds do NOT use this file. They get their values
# from the `env` block in eas.json (native) or the workflow env in
# .github/workflows/deploy-web.yml (web). Both are set explicitly so that a
# build can never inherit dev credentials by accident.
#
# The anon/publishable key is safe to commit — it is designed to ship inside
# the client and is protected by RLS. The service-role key is not; it lives in
# supabase/config.secret.js.

EXPO_PUBLIC_SUPABASE_URL=https://fguutbhbzradrdyrxixg.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXYU9OBfhMhMQevUmFQGsQ_GhTVmNNB
