# Copy to .env.local (gitignored) for local development and e2e, or let
# `npm run dev:local` write one for you.
#
# These point at a local `supabase start` stack (see the root README). The key
# is the stack's standard demo anon key, the same on every machine. The hosted
# dev project that used to live here was deleted in September 2026. Never put
# the production project here: .env.local is what `expo start` and Playwright
# pick up, and seeding writes fixtures.
#
# Production and preview builds do NOT use this file. They get their values
# from the `env` block in eas.json (native) or the workflow env in
# .github/workflows/deploy-web.yml (web). Both are set explicitly so that a
# build can never inherit dev credentials by accident.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
