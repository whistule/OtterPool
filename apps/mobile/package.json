{
  "name": "@otterpool/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "pretest:e2e": "npm --prefix ../../supabase run seed:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.105.1",
    "expo": "^56.0.0",
    "expo-constants": "~56.0.22",
    "expo-dev-client": "~56.0.24",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.22",
    "expo-linking": "~56.0.16",
    "expo-notifications": "~56.0.22",
    "expo-router": "~56.2.17",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.23",
    "expo-web-browser": "~56.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "uuid": "^14.0.0"
  },
  "//playwright": "@playwright/test is pinned exactly. Browsers come from devenv (pkgs.playwright-driver.browsers), which ships chromium_headless_shell-1217 — the build Playwright 1.59.x expects. A caret range lets npm install 1.62, which looks for -1234 and fails to launch every test. Bump this only together with devenv's nixpkgs.",
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/react": "~19.2.10",
    "@types/uuid": "^10.0.0",
    "eas-cli": "^18.11.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
