{
  "name": "@otterpool/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "//packageManager": "Pin npm to the version devenv's node ships (24.20.0 → npm 11.19.0), which the workflows also pin. Keep the two in step: a lockfile written by npm 11 fails `npm ci` under npm 10 with \"Missing: <pkg> from lock file\".",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev:local": "../../scripts/dev-local.sh",
    "pretest:e2e": "npm --prefix ../../supabase run seed:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "node --test lib/*.test.ts ../../supabase/*.test.js ../../supabase/functions/_shared/*.test.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.111.0",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "uuid": "^14.0.0"
  },
  "//playwright": "@playwright/test is pinned exactly, and must match devenv. Browsers come from pkgs.playwright-driver.browsers, currently chromium_headless_shell-1228 — the build Playwright 1.61.x expects. Any other version looks for a revision that isn't in the nix store and every test fails to launch a browser. When bumping devenv's nixpkgs, check the new browser build number and move this pin with it.",
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "~19.2.10",
    "@types/uuid": "^10.0.0",
    "eas-cli": "^21.4.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
